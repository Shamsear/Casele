// ─── Prisma Schema for Casele E-Commerce Store ────────────────
// Migrated from Drizzle ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Phone Models ──────────────────────────────────────────────
model PhoneModel {
  id        String   @id @default(uuid()) @db.Uuid
  brand     String                                  // "iPhone", "Samsung", "Google"
  modelName String                                  // "iPhone 15 Pro Max"
  slug      String   @unique                        // "iphone-15-pro-max"
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  products ProductModel[]

  @@map("phone_models")
}

// ─── Categories ────────────────────────────────────────────────
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String                                  // "Classic Collection"
  slug        String   @unique                        // "classic-collection"
  description String?
  imageUrl    String?  @map("image_url")
  salePercent Int?     @map("sale_percent")           // Category-level sale
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  products Product[]

  @@map("categories")
}

// ─── Products ──────────────────────────────────────────────────
model Product {
  id              String    @id @default(uuid()) @db.Uuid
  name            String                                    // "Midnight Black Premium Case"
  slug            String    @unique                         // "midnight-black-premium-case"
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  comparePrice    Decimal?  @db.Decimal(10, 2) @map("compare_price")
  images          String[]  @default([])                    // Array of image URLs
  categoryId      String?   @map("category_id") @db.Uuid
  badge           String?                                    // 'new' | 'bestseller' | 'sale'
  isFeatured      Boolean   @default(false) @map("is_featured")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  viewCount       Int       @default(0) @map("view_count")
  orderCount      Int       @default(0) @map("order_count")
  lastSoldAt      DateTime? @map("last_sold_at")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  category        Category?         @relation(fields: [categoryId], references: [id])
  productModels   ProductModel[]
  bundles         ProductBundle[]   @relation("ProductBundles")
  bundledIn       ProductBundle[]   @relation("BundledProducts")

  @@map("products")
}

// ─── Product ↔ Phone Model (many-to-many) ─────────────────────
model ProductModel {
  productId String @map("product_id") @db.Uuid
  modelId   String @map("model_id") @db.Uuid
  stock     Int    @default(0)

  // Relations
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  model   PhoneModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([productId, modelId])
  @@map("product_models")
}

// ─── Product Bundles (cross-sell) ─────────────────────────────
model ProductBundle {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  bundledProductId  String   @map("bundled_product_id") @db.Uuid
  bundleDiscount    Int?     @map("bundle_discount")    // Percentage off
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  product         Product @relation("ProductBundles", fields: [productId], references: [id], onDelete: Cascade)
  bundledProduct  Product @relation("BundledProducts", fields: [bundledProductId], references: [id], onDelete: Cascade)

  @@map("product_bundles")
}

// ─── Promo Codes ──────────────────────────────────────────────
model PromoCode {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique                         // "SUMMER20"
  discountType   String    @map("discount_type")           // 'percentage' | 'flat'
  discountValue  Decimal   @db.Decimal(10, 2) @map("discount_value")
  minOrder       Decimal   @default(0) @db.Decimal(10, 2) @map("min_order")
  maxUses        Int?      @map("max_uses")                // NULL = unlimited
  perUserLimit   Int       @default(1) @map("per_user_limit")
  appliesTo      String    @default("all") @map("applies_to") // 'all' | 'category' | 'products'
  appliesToIds   String[]  @default([]) @map("applies_to_ids")
  stackable      Boolean   @default(false)
  autoApply      Boolean   @default(false) @map("auto_apply")
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  isActive       Boolean   @default(true) @map("is_active")
  usedCount      Int       @default(0) @map("used_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  promoCodeUses PromoCodeUse[]
  orders        Order[]

  @@map("promo_codes")
}

// ─── Promo Code Usage ─────────────────────────────────────────
model PromoCodeUse {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerPhone  String?  @map("customer_phone")
  discountAmount Decimal  @db.Decimal(10, 2) @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("promo_code_uses")
}

// ─── Flash Sales ──────────────────────────────────────────────
model FlashSale {
  id            String    @id @default(uuid()) @db.Uuid
  name          String                                    // "Independence Day Sale"
  discountType  String    @map("discount_type")           // 'percentage' | 'flat'
  discountValue Decimal   @db.Decimal(10, 2) @map("discount_value")
  appliesTo     String    @default("all") @map("applies_to") // 'all' | 'category' | 'products'
  appliesToIds  String[]  @default([]) @map("applies_to_ids")
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime  @map("ends_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("flash_sales")
}

// ─── Tiered Discounts ─────────────────────────────────────────
model TierDiscount {
  id               String  @id @default(uuid()) @db.Uuid
  minAmount        Decimal @db.Decimal(10, 2) @map("min_amount")
  discountPercent  Int     @map("discount_percent")
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")

  @@map("tier_discounts")
}

// ─── Orders ───────────────────────────────────────────────────
model Order {
  id             String    @id @default(uuid()) @db.Uuid
  customerName   String    @map("customer_name")
  customerPhone  String    @map("customer_phone")
  address        String?
  items          Json                                      // [{productId, name, model, qty, price}]
  subtotal       Decimal   @db.Decimal(10, 2)
  tierDiscount   Decimal   @default(0) @db.Decimal(10, 2) @map("tier_discount")
  flashDiscount  Decimal   @default(0) @db.Decimal(10, 2) @map("flash_discount")
  promoDiscount  Decimal   @default(0) @db.Decimal(10, 2) @map("promo_discount")
  bundleDiscount Decimal   @default(0) @db.Decimal(10, 2) @map("bundle_discount")
  total          Decimal   @db.Decimal(10, 2)
  promoCodeId    String?   @map("promo_code_id") @db.Uuid
  status         String    @default("pending")            // pending/confirmed/dispatched/delivered/cancelled
  priority       String    @default("normal")             // 'normal' | 'urgent'
  notes          String?
  whatsappSent   Boolean   @default(false) @map("whatsapp_sent")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
  promoCodeUses  PromoCodeUse[]

  @@map("orders")
}

// ─── Admin Users ──────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  activityLogs AdminActivityLog[]

  @@map("admin_users")
}

// ─── Admin Activity Log ───────────────────────────────────────
model AdminActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String                                    // 'create_product', 'update_order', etc.
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@map("admin_activity_log")
}

// ─── Settings (key-value) ─────────────────────────────────────
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── Bundle Discount Configuration ────────────────────────────
model BundleDiscountConfig {
  id          String   @id @default(uuid()) @db.Uuid
  buy2Percent Int      @default(5) @map("buy_2_percent")
  buy3Percent Int      @default(10) @map("buy_3_percent")
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bundle_discount_configs")
}

// ─── Delivery Configuration ───────────────────────────────────
model DeliveryConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  freeThreshold        Decimal  @default(100) @db.Decimal(10, 2) @map("free_threshold")
  expressFee           Decimal  @default(20) @db.Decimal(10, 2) @map("express_fee")
  isFreeDeliveryActive Boolean  @default(true) @map("is_free_delivery_active")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("delivery_configs")
}

